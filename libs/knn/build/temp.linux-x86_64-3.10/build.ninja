ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -Wno-unused-result -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -fPIC -DWITH_CUDA -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/TH -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/include -I/usr/local/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=knn_pytorch -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -DWITH_CUDA -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/TH -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda/include -I/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/py310/include -I/usr/local/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=knn_pytorch -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/build/temp.linux-x86_64-3.10/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/cpu/knn_cpu.o: compile /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/cpu/knn_cpu.cpp
build /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/build/temp.linux-x86_64-3.10/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/cuda/knn.o: cuda_compile /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/cuda/knn.cu
build /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/build/temp.linux-x86_64-3.10/media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/vision.o: compile /media/dsp520/Grasp_2T/EconomicGrasp/EconomicGrasp/libs/knn/src/vision.cpp






